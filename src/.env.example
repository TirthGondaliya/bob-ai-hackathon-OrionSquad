# =============================================================================
# NexusSupply AI - Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git (it is in .gitignore).
# =============================================================================

# IBM watsonx.ai Credentials (Optional for local testing, required for live cloud)
# If left as placeholder, the system runs with the integrated IBM Granite 3.0 autonomous reasoning engine
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Application Settings
APP_PORT=8000
APP_ENV=development

# Telematics & IoT Simulation
IOT_SAMPLE_INTERVAL_SECONDS=10
DEFAULT_MKT_THRESHOLD_C=10.0

# Optional Basemap API Key (Default is CartoDB Dark Matter which requires NO key)
# Supported providers: mapbox | stadia | geoapify | custom
BASEMAP_PROVIDER=cartodb
BASEMAP_API_KEY=your_basemap_api_key_here
# Optional custom tile URL template:
# BASEMAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/dark-v11/tiles/{z}/{x}/{y}?access_token=YOUR_KEY
